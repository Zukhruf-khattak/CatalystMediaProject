# ==============================================================================
# Catalist Meeting Intelligence Agent - Environment Configuration
# ==============================================================================
# Safe defaults and placeholders for local development.
# Copy this file to .env and adjust values for your local environment:
#   cp .env.example .env
# NEVER commit a real .env file with secrets to version control.
# ==============================================================================

# Application Metadata
APP_NAME="Catalist Meeting Intelligence"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Server Bindings
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# CORS Configuration (comma-separated list of allowed origins)
# Unrestricted '*' must never be used in production.
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Database Configuration (PostgreSQL 16 + pgvector)
# For local Docker Compose:
DATABASE_URL="postgresql+psycopg://catalist_user:catalist_password@localhost:5432/catalist_db"
# Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Observability - LangSmith Tracing
# Tracing is optional. Set LANGSMITH_TRACING=false to run without credentials.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="catalist-meeting-intelligence"

# Model Providers (Local-First / Free-Tier Friendly)
# Active provider: "ollama" (local fallback) or "gemini" (optional free tier)
LLM_PROVIDER="ollama"
LLM_MODEL="llama3.2"
OLLAMA_BASE_URL="http://localhost:11434"
# Optional Gemini API Key (only needed if LLM_PROVIDER="gemini")
GEMINI_API_KEY=""

# Logging Configuration
# Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# Dataset & Ingestion Configuration (Phase 2)
DATASET_DIR="data/raw"
DATASET_ARCHIVE_PATH="data/raw/Catalist_AI_Intern_Build_Test_Data.zip"
ARCHIVE_MAX_SIZE_BYTES=52428800
ARCHIVE_MAX_EXTRACTED_FILES=500
PARSER_VERSION="1.0.0"
FTS_LANGUAGE_CONFIG="english"

# Embedding Configuration (sentence-transformers/all-MiniLM-L6-v2)
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE="cpu"

